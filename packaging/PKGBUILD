# Maintainer: bstar <bob@dinicolas.com>
pkgname=starwire
pkgver=0.0.2
pkgrel=1
pkgdesc="A stack-based terminal news reader in the STAR family"
arch=('x86_64' 'aarch64')
url="https://github.com/bstar/starwire"
license=('MIT')
# The C runtime, and nothing else. SQLite is the amalgamation `rusqlite`
# compiles from source and TLS is rustls: there is no libsqlite3, no OpenSSL
# and no libxml2 in this tree.
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
# `mpv` and `yt-dlp` are what a video entry is handed to, and neither is a
# dependency: they are the reader's own programs, looked up on PATH when a
# video is played, and everything else works without them.
optdepends=('mpv: play a video entry'
            'yt-dlp: resolve a YouTube handle, and import real subscriptions')
# The crumbs, rules and marks STAR/WIRE draws are plain Unicode box-drawing
# and block characters, which every terminal font already carries -- unlike
# STAR/CORD, there is no pictograph or colour-emoji dependency to name here.
# makepkg enables LTO by default, which makes any C a dependency compiles land
# in its static archive as LTO bitcode. rustc links with lld, which does not
# read it, and the symbols come back undefined. The Rust toolchain does its
# own LTO through the release profile regardless.
options=(!lto)
# The release tarball, not GitHub's generated /archive/ one: that is produced
# on the fly and its bytes have changed under the AUR before, invalidating
# every checksum at once. This one is built by `git archive` at the tag and
# uploaded, so it can carry a real checksum.
#
# SKIP here, and only here: the hash of a tarball made from this tree cannot be
# written into this tree without changing it. The AUR copy of this file is
# published after the release exists and carries the real value, which is the
# copy anybody actually installs from.
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # This needs network, which prepare() has and build() should not rely on.
  # One of the dependencies is not on crates.io: `starkit` is this project's
  # own shared foundation, pinned to a git tag in Cargo.lock, and `cargo fetch`
  # is what puts it in CARGO_HOME so that the --frozen build below can be
  # offline like every other Arch build.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Anything here that needs the network is gated behind STARWIRE_TEST_NET
  # and skips cleanly without it, so this build stays offline.
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 packaging/starwire.desktop \
    "$pkgdir/usr/share/applications/starwire.desktop"
  install -Dm0644 packaging/starwire.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/starwire.png"
  install -Dm0644 packaging/starwire.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/starwire.svg"
}
